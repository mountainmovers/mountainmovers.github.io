---
import { getEntry } from "astro:content";

const company = await getEntry("site", "company");
if (!company) throw new Error("Missing site/company content entry");
const campaign = company.data.donorbox_campaign;
---

<div class="donorbox">
  <script src="https://donorbox.org/widget.js" is:inline></script>
  <iframe
    src={`https://donorbox.org/embed/${campaign}`}
    name="donorbox"
    title="Donate to Mountain Movers International"
    height="685px"
    width="100%"
    seamless
    frameborder="0"
    scrolling="no"></iframe>
</div>

<style>
  .donorbox {
    display: flex;
    justify-content: center;
  }

  iframe {
    max-width: 500px;
    min-width: 310px;
    max-height: none !important;
  }
</style>
