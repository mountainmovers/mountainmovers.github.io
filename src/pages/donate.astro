---
import BaseLayout from "../layouts/BaseLayout.astro";
import DonorboxEmbed from "../components/DonorboxEmbed.astro";
---

<BaseLayout
  title="Donate"
  description="Support Mountain Movers International — your gift bridges needs and resources on the world's hardest mission fields."
>
  <section class="page-hero">
    <div class="container">
      <p class="kicker">Give</p>
      <h1>Make a Donation</h1>
      <p class="lede">
        Your gift goes to work where the need is greatest — standing with faithful workers in the
        most hopeless situations.
      </p>
    </div>
  </section>

  <section class="donate-section">
    <div class="container">
      <DonorboxEmbed />
    </div>
  </section>
</BaseLayout>

<style>
  .donate-section {
    padding-block: var(--space-5);
  }
</style>
