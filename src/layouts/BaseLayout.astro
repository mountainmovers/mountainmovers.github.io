---
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/source-sans-3";
import "../styles/global.css";
import { getEntry } from "astro:content";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogType?: string;
  noindex?: boolean;
}

const { title, description, ogType, noindex } = Astro.props;

const company = await getEntry("site", "company");
if (!company) throw new Error("Missing site/company content entry");

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": ["Organization", "NGO"],
  name: company.data.company_name,
  url: Astro.site?.toString(),
  logo: new URL("/images/logo-heritage-full.jpg", Astro.site).toString(),
  description: company.data.tagline,
  foundingDate: String(company.data.founding_year),
  founder: { "@type": "Person", name: "Wayne Hamit" },
  email: company.data.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "P.O. Box 896",
    addressLocality: "Lake Dallas",
    addressRegion: "TX",
    postalCode: "75065",
    addressCountry: "US",
  },
  nonprofitStatus: "Nonprofit501c3",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} ogType={ogType} noindex={noindex} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/interactions.js"></script>
  </body>
</html>
